<Window x:Class="CycleArc.UI.FloatingWidget"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:CycleArc.UI"
        xmlns:text="clr-namespace:CycleArc.Services;assembly=CycleArc.Core"
        Title="{x:Static text:UiText.WidgetTitle}" Style="{StaticResource AppWindow}"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        Focusable="True"
        PreviewKeyDown="OnPreviewKeyDown"
        PreviewMouseLeftButtonDown="OnPreviewLeftDown"
        PreviewMouseMove="OnPreviewMouseMove"
        PreviewMouseLeftButtonUp="OnPreviewLeftUp"
        LostMouseCapture="OnLostMouseCapture" MouseDown="OnMouseDown">
    <Window.Resources>
        <Style x:Key="WidgetIconButton" TargetType="Button">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="28"/>
            <!-- Use the header's existing vertical breathing room, keeping its layout at 22 DIP. -->
            <Setter Property="Margin" Value="0,-3,0,-3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Tag" Value="{DynamicResource {x:Static SystemParameters.HighContrastKey}}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="WidgetIconChrome" Background="{TemplateBinding Background}" CornerRadius="6"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="WidgetIconChrome" Property="Background" Value="{DynamicResource GhostBrush}"/>
                                <Setter TargetName="WidgetIconChrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="WidgetIconChrome" Property="Background" Value="{DynamicResource GhostBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="WidgetIconChrome" Property="Background" Value="{DynamicResource SelectionBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="WidgetIconChrome" Property="Background" Value="Transparent"/>
                                <Setter Property="Opacity" Value="0.45"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
                                <Setter TargetName="WidgetIconChrome" Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/>
                                <Setter TargetName="WidgetIconChrome" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
                            </DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True"/>
                                    <Condition Binding="{Binding IsKeyboardFocused, RelativeSource={RelativeSource Self}}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/>
                                <Setter TargetName="WidgetIconChrome" Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                                <Setter TargetName="WidgetIconChrome" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/>
                            </MultiDataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True"/>
                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/>
                                <Setter TargetName="WidgetIconChrome" Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                            </MultiDataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True"/>
                                    <Condition Binding="{Binding IsPressed, RelativeSource={RelativeSource Self}}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/>
                                <Setter TargetName="WidgetIconChrome" Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                                <Setter TargetName="WidgetIconChrome" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/>
                                <Setter TargetName="WidgetIconChrome" Property="BorderThickness" Value="2"/>
                            </MultiDataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True"/>
                                    <Condition Binding="{Binding IsEnabled, RelativeSource={RelativeSource Self}}" Value="False"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Opacity" Value="1"/>
                                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                                <Setter TargetName="WidgetIconChrome" Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/>
                                <Setter TargetName="WidgetIconChrome" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                                <Setter TargetName="WidgetIconChrome" Property="BorderThickness" Value="1"/>
                            </MultiDataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <!-- The opacity setting applies to this ground only; names, numbers and rings stay opaque. -->
    <!-- The zoom scales the whole root, so the ground and content grow together and the
         root still reports its unscaled layout size, as the single panel did before. -->
    <Grid x:Name="WidgetRoot" RenderTransformOrigin="0,0" KeyboardNavigation.TabNavigation="Cycle">
    <Grid.LayoutTransform>
        <ScaleTransform x:Name="WidgetScale" ScaleX="1" ScaleY="1"/>
    </Grid.LayoutTransform>
    <Border x:Name="WidgetBackdrop"
            Background="{DynamicResource BgBrush}"
            CornerRadius="12"
            BorderBrush="{DynamicResource LineBrush}"
            BorderThickness="1"
            IsHitTestVisible="False"/>
    <!-- Transparent, not null, so empty parts of the widget still take clicks and drags. -->
    <Border x:Name="WidgetPanel"
            Background="Transparent"
            RenderTransformOrigin="0,0"
            CornerRadius="12"
            Padding="10,9"
            BorderBrush="Transparent"
            BorderThickness="1"
            MinWidth="168">
        <StackPanel x:Name="WidgetStatusStack">
            <!-- One header for the whole widget; never repeated per account. -->
            <Grid x:Name="WidgetHeader" Height="22" Margin="0,0,0,7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*" MinWidth="0"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Viewbox Width="15" Height="15" Stretch="Uniform" Margin="1,0,7,0">
                        <Canvas Width="24" Height="24">
                            <Path x:Name="WidgetLogoPath" Stroke="{DynamicResource TextBrush}" StrokeThickness="5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M17,18 A8,8 0 1 1 12,4"/>
                            <Ellipse Canvas.Left="16" Canvas.Top="0" Width="6" Height="6" Fill="{DynamicResource AccentBrush}"/>
                        </Canvas>
                    </Viewbox>
                    <TextBlock x:Name="ProductTitle" Text="{x:Static text:UiText.ProductName}" FontSize="12"
                               FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}"/>
                </StackPanel>
                <TextBlock x:Name="AccountCountText" Grid.Column="1" Margin="10,0,10,0" FontSize="10.5"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                           Foreground="{DynamicResource MutedBrush}"/>
                <Button x:Name="WidgetZoomOutButton" Grid.Column="2" Style="{StaticResource WidgetIconButton}"
                        Click="OnZoomOutClick">
                    <Path x:Name="WidgetZoomOutIcon" Width="16" Height="16"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M10.5,6 A4.5,4.5 0 1 1 1.5,6 A4.5,4.5 0 1 1 10.5,6 M9.3,9.3 L14,14 M3.75,6 L8.25,6"/>
                </Button>
                <TextBlock x:Name="WidgetZoomPercentText" Grid.Column="3" Text="100%" Width="30" Height="16" Margin="0,0,2,0"
                           FontSize="10.5" TextAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource MutedBrush}" Typography.NumeralAlignment="Tabular"/>
                <Button x:Name="WidgetZoomInButton" Grid.Column="4" Style="{StaticResource WidgetIconButton}"
                        Click="OnZoomInClick">
                    <Path x:Name="WidgetZoomInIcon" Width="16" Height="16"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M10.5,6 A4.5,4.5 0 1 1 1.5,6 A4.5,4.5 0 1 1 10.5,6 M9.3,9.3 L14,14 M3.75,6 L8.25,6 M6,3.75 L6,8.25"/>
                </Button>
                <Button x:Name="WidgetRefreshButton" Grid.Column="5" Style="{StaticResource WidgetIconButton}"
                        Click="OnRefreshClick">
                    <TextBlock x:Name="WidgetRefreshGlyph" Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                </Button>
                <Button x:Name="WidgetSettingsButton" Grid.Column="6" Style="{StaticResource WidgetIconButton}"
                        Click="OnSettingsClick">
                    <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                </Button>
                <Button x:Name="WidgetCloseButton" Grid.Column="7" Style="{StaticResource WidgetIconButton}"
                        Click="OnCloseClick">
                    <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                </Button>
            </Grid>
            <!-- Modules wrap into rows; only a grid taller than the work area scrolls. -->
            <ScrollViewer x:Name="ModuleScroller" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <Grid x:Name="ModuleHost"/>
            </ScrollViewer>
            <TextBlock x:Name="EmptyStateText" Visibility="Collapsed" FontSize="11" TextWrapping="Wrap"
                       MaxWidth="200" Margin="2,2,2,2" Foreground="{DynamicResource MutedBrush}"/>
        </StackPanel>
    </Border>
    </Grid>
</Window>
