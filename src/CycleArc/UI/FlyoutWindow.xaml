<Window x:Class="CycleArc.UI.FlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:CycleArc.UI"
        xmlns:text="clr-namespace:CycleArc.Services;assembly=CycleArc.Core"
        Title="{x:Static text:UiText.ProductName}" FontFamily="Segoe UI" FontSize="14" UseLayoutRounding="True"
        Width="440"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="False"
        ResizeMode="NoResize"
        PreviewKeyDown="OnPreviewKeyDown">
    <Window.Resources>
        <Style x:Key="FlyoutValueText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
        <Style x:Key="FlyoutHeaderIconButton" TargetType="Button">
            <Setter Property="MinWidth" Value="28"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{DynamicResource GhostBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="HeaderIconChrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HeaderIconChrome" Property="Background" Value="{DynamicResource SelectionBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="HeaderIconChrome" Property="Background" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource DisabledBrush}"/>
                                <Setter TargetName="HeaderIconChrome" Property="Background" Value="{DynamicResource GhostBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="UsagePeriodChoice" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="PeriodChrome" Padding="12,5" Background="Transparent" BorderThickness="0,0,0,2" BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PeriodChrome" Property="Background" Value="{DynamicResource SelectionBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter TargetName="PeriodChrome" Property="BorderBrush" Value="{DynamicResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="PeriodChrome" Property="Background" Value="{DynamicResource SelectionBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="UsageRingButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RingChrome" Padding="5" Background="Transparent" BorderThickness="1" BorderBrush="Transparent" CornerRadius="8">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RingChrome" Property="Background" Value="{DynamicResource GhostBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="RingChrome" Property="BorderBrush" Value="{DynamicResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
                <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="Vertical">
                    <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0"/></Track.DecreaseRepeatButton>
                    <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="{DynamicResource MutedBrush}" CornerRadius="4" Opacity="0.6" Margin="1,3"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
                    <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0"/></Track.IncreaseRepeatButton>
                </Track>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <Border x:Name="FlyoutSurface" Width="440" Background="{DynamicResource CardBrush}"
            BorderBrush="{DynamicResource LineBrush}"
            BorderThickness="1"
            CornerRadius="14"
            Padding="0"
            ClipToBounds="True">
        <Border.LayoutTransform>
            <ScaleTransform x:Name="FlyoutScale" ScaleX="1" ScaleY="1"/>
        </Border.LayoutTransform>
        <DockPanel>
            <Grid x:Name="FlyoutHeaderGrid"
                  DockPanel.Dock="Top"
                  Margin="14,14,14,8"
                  MouseLeftButtonDown="OnHeaderMouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*" MinWidth="0"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <Border Background="{DynamicResource GhostBrush}" CornerRadius="9" Width="28" Height="28" Margin="0,0,10,0">
                        <Viewbox Width="20" Height="20" Stretch="Uniform">
                            <Canvas Width="24" Height="24">
                                <Path x:Name="HeaderLogoPath" Stroke="{DynamicResource TextBrush}" StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M17,18 A8,8 0 1 1 12,4"/>
                                <Ellipse Canvas.Left="16" Canvas.Top="0" Width="6" Height="6" Fill="{DynamicResource AccentBrush}"/>
                            </Canvas>
                        </Viewbox>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText" Text="{x:Static text:UiText.ProductName}" FontWeight="SemiBold" FontSize="16" Foreground="{DynamicResource TextBrush}"/>
                        <TextBlock x:Name="VersionText" FontSize="9" Foreground="{DynamicResource MutedBrush}"/>
                    </StackPanel>
                </StackPanel>

                <Grid Grid.Column="1" Margin="0,0,12,0" MinWidth="0" HorizontalAlignment="Right"><Ellipse x:Name="StatusDot" Width="8" Height="8" HorizontalAlignment="Left" VerticalAlignment="Center" Fill="{DynamicResource OkBrush}"/>
                    <TextBlock x:Name="StatusText" Margin="14,0,0,0"
                               HorizontalAlignment="Stretch"
                               TextAlignment="Right"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource MutedBrush}"
                               FontSize="11"/>
                    <TextBlock x:Name="RefreshProgressText" Margin="14,0,0,0"
                               HorizontalAlignment="Stretch"
                               TextAlignment="Right"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource AccentBrush}"
                               FontSize="11"
                               Visibility="Collapsed"/>
                </Grid>
                <Button x:Name="RefreshAllButton"
                        Grid.Column="2"
                        Style="{StaticResource FlyoutHeaderIconButton}"
                        Click="OnRefreshAllClick"
                        ToolTip="Refresh all"
                        AutomationProperties.Name="Refresh all"
                        Margin="0,0,4,0">
                    <Grid Width="18" Height="18">
                        <Path x:Name="RefreshAllIcon" Width="18" Height="18" Stretch="Uniform"
                              Stroke="{DynamicResource TextBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M17,7 A7,7 0 0 0 4,4 M17,2 L17,7 L12,7 M3,13 A7,7 0 0 0 16,16 M3,18 L3,13 L8,13"/>
                        <Viewbox x:Name="RefreshSpinner"
                                 Width="16"
                                 Height="16"
                                 Stretch="Uniform"
                                 Visibility="Collapsed"
                                 RenderTransformOrigin="0.5,0.5">
                            <Viewbox.RenderTransform>
                                <RotateTransform x:Name="RefreshSpinnerRotate" Angle="0"/>
                            </Viewbox.RenderTransform>
                            <Path Stroke="{DynamicResource AccentBrush}"
                                  StrokeThickness="2.2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Fill="Transparent"
                                  Stretch="None"
                                  Width="16"
                                  Height="16">
                                <Path.Data>
                                    <PathGeometry>
                                        <PathFigure StartPoint="14,8" IsClosed="False">
                                            <ArcSegment Point="8,2"
                                                        Size="6,6"
                                                        SweepDirection="Clockwise"
                                                        IsLargeArc="True"
                                                        IsStroked="True"/>
                                        </PathFigure>
                                    </PathGeometry>
                                </Path.Data>
                            </Path>
                        </Viewbox>
                    </Grid>
                </Button>
                <Button x:Name="SettingsButton" Grid.Column="3"
                        Style="{StaticResource FlyoutHeaderIconButton}" Click="OnSettingsClick" Margin="0,0,4,0">
                    <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                               Foreground="{DynamicResource TextBrush}"/>
                </Button>
                <Button x:Name="PinButton"
                        Grid.Column="4"
                        Style="{StaticResource FlyoutHeaderIconButton}"
                        Click="OnPinClick"
                        ToolTip="Pin"
                        AutomationProperties.Name="Pin"
                        Margin="0,0,4,0">
                    <Grid Width="14" Height="14">
                        <Path x:Name="PinOutline"
                              Stroke="{DynamicResource TextBrush}"
                              StrokeThickness="1.4"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              Fill="Transparent"
                              Stretch="Uniform"
                              Data="M7,1 C5.3,1 4,2.5 4,4.2 L4,7.2 L2.2,7.2 L2.2,8.8 L6.2,8.8 L6.2,13 L7.8,13 L7.8,8.8 L11.8,8.8 L11.8,7.2 L10,7.2 L10,4.2 C10,2.5 8.7,1 7,1 Z"/>
                        <Path x:Name="PinFilled"
                              Fill="{DynamicResource AccentBrush}"
                              Stroke="{DynamicResource AccentBrush}"
                              StrokeThickness="0.4"
                              Stretch="Uniform"
                              Visibility="Collapsed"
                              Data="M7,1 C5.3,1 4,2.5 4,4.2 L4,7.2 L2.2,7.2 L2.2,8.8 L6.2,8.8 L6.2,13 L7.8,13 L7.8,8.8 L11.8,8.8 L11.8,7.2 L10,7.2 L10,4.2 C10,2.5 8.7,1 7,1 Z"/>
                    </Grid>
                </Button>
                <Button x:Name="CloseFlyoutButton"
                        Grid.Column="5"
                        Style="{StaticResource FlyoutHeaderIconButton}"
                        Click="OnCloseClick"
                        ToolTip="Close"
                        AutomationProperties.Name="Close">
                    <Path Width="12"
                          Height="12"
                          Stroke="{DynamicResource TextBrush}"
                          StrokeThickness="1.6"
                          StrokeStartLineCap="Round"
                          Data="M2,2 L10,10 M10,2 L2,10"
                          Stretch="Uniform"/>
                </Button>
            </Grid>
            <ScrollViewer x:Name="FlyoutContentScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="14,4,14,14" MaxHeight="640">
                <StackPanel>
                    <StackPanel x:Name="AccountSection" Visibility="Collapsed" Margin="0,0,0,12">
                        <DockPanel Margin="0,0,0,8">
                            <Button x:Name="ManageAccountsButton" DockPanel.Dock="Right" Style="{StaticResource CreditUseButton}"
                                    Padding="10,5" Click="OnAccountsClick"/>
                            <TextBlock x:Name="AccountsHeading" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </DockPanel>
                        <ItemsControl x:Name="AccountOverview"/>
                        <TextBlock x:Name="AccountSelectionHint" FontSize="11" Foreground="{DynamicResource MutedBrush}"
                                   TextWrapping="Wrap" Margin="0,2,0,8"/>
                    </StackPanel>
                    <Grid x:Name="SelectedAccountHeader" HorizontalAlignment="Left" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="SelectedAccountText" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" Margin="0,0,8,0" Visibility="Collapsed" Foreground="{DynamicResource TextBrush}"/>
                        <ui:UsageProviderBadge x:Name="SelectedProviderBadge" Grid.Column="1"/>
                    </Grid>
                    <Border x:Name="CodexCard" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="12">
                        <StackPanel>
                            <StackPanel x:Name="ClaudeUsageHeader" Visibility="Collapsed" Margin="0,0,0,8">
                                <TextBlock x:Name="ClaudeUsageTitle" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock x:Name="ClaudeUsageScope" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"/>
                            </StackPanel>
                            <TextBlock x:Name="CodexStatusText" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8" Visibility="Collapsed"/>
                            <StackPanel Margin="0,0,0,12">
                                <DockPanel LastChildFill="False">
                                    <TextBlock x:Name="UsagePeriodLabel" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextBrush}" Margin="0,0,12,0"/>
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="AutoPeriodButton" GroupName="UsagePeriod" Style="{StaticResource UsagePeriodChoice}" Checked="OnUsagePeriodChecked"/>
                                        <RadioButton x:Name="FiveHourPeriodButton" GroupName="UsagePeriod" Style="{StaticResource UsagePeriodChoice}" Checked="OnUsagePeriodChecked"/>
                                        <RadioButton x:Name="WeeklyPeriodButton" GroupName="UsagePeriod" Style="{StaticResource UsagePeriodChoice}" Checked="OnUsagePeriodChecked"/>
                                    </StackPanel>
                                </DockPanel>
                                <TextBlock x:Name="UsagePeriodHint" FontSize="11" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                <TextBlock x:Name="UsagePeriodFallback" FontSize="11" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed"/>
                            </StackPanel>
                            <Grid x:Name="CodexBodyGrid">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <Button x:Name="CyclePeriodButton" Style="{StaticResource UsageRingButton}" Click="OnCyclePeriodClick" HorizontalAlignment="Center">
                                        <Grid x:Name="CodexRingHost" Width="112" Height="112">
                                            <Ellipse x:Name="CodexRingTrack" Width="112" Height="112" StrokeThickness="10" Stroke="{DynamicResource LineBrush}"/>
                                            <Path x:Name="CodexRingArcPath" StrokeThickness="10" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stroke="{DynamicResource AccentBrush}" Fill="Transparent" Visibility="Collapsed">
                                                <Path.Data><PathGeometry><PathFigure x:Name="CodexRingFigure" IsClosed="False"><ArcSegment x:Name="CodexRingArcSegment" SweepDirection="Clockwise"/></PathFigure></PathGeometry></Path.Data>
                                            </Path>
                                            <Ellipse x:Name="CodexRingFullCircle" Width="112" Height="112" StrokeThickness="10" Stroke="{DynamicResource AccentBrush}" Visibility="Collapsed"/>
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock x:Name="CodexRingValueText" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{DynamicResource TextBrush}"/>
                                                <TextBlock x:Name="CodexRingSubLabel" FontSize="11" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="96" Margin="0,4,0,0" Foreground="{DynamicResource MutedBrush}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </StackPanel>
                                <Border Grid.Column="1" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1,0,0,0" Padding="12,0,0,0" Margin="4,0,0,0">
                                    <ItemsControl x:Name="CodexRows" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                            <Button x:Name="ClaudeUsagePageButton" Style="{StaticResource CreditUseButton}" Click="OnClaudeUsagePage"
                                    HorizontalAlignment="Left" Margin="0,10,0,0" Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="ResetCreditsCard" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,12,0,0">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock x:Name="ResetCreditsTitle" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}"/>
                                <Border Grid.Column="1" Background="{DynamicResource LineBrush}" CornerRadius="14" Margin="10,0,0,0">
                                    <Button x:Name="CreditHelpButton" Style="{StaticResource FlyoutHeaderIconButton}" Background="Transparent" Padding="10,2" Click="OnCreditHelpClick">
                                        <TextBlock x:Name="ResetCreditsCount" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                                    </Button>
                                </Border>
                                <Button x:Name="CreditExpandButton" Grid.Column="2" HorizontalAlignment="Right" Style="{StaticResource FlyoutHeaderIconButton}" Background="Transparent" Click="OnCreditExpandClick">
                                    <Path x:Name="CreditExpandChevron" Width="12" Height="7" Stretch="Uniform" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M1,7 L7,1 L13,7"/>
                                </Button>
                            </Grid>
                            <StackPanel x:Name="CreditDetails" Margin="0,8,0,0">
                            <Border x:Name="CreditListBorder" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="12,0">
                                <ScrollViewer x:Name="CreditExpiryScroll" Height="108" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                                    <ItemsControl x:Name="CreditExpiryRows"/>
                                </ScrollViewer>
                            </Border>
                            <TextBlock x:Name="CreditExpiryNotice" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
