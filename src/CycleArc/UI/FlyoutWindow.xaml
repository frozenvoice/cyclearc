<Window x:Class="CycleArc.UI.FlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:CycleArc.UI"
        xmlns:text="clr-namespace:CycleArc.Services;assembly=CycleArc.Core"
        Title="{x:Static text:UiText.ProductName}" FontFamily="Segoe UI" FontSize="14" UseLayoutRounding="True"
        Width="440"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="False"
        ResizeMode="NoResize"
        PreviewKeyDown="OnPreviewKeyDown">
    <Window.Resources>
        <Style x:Key="FlyoutValueText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
        <Style x:Key="FlyoutHeaderIconButton" TargetType="Button">
            <Setter Property="MinWidth" Value="28"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <!-- Icons rest without a box; the chrome appears on hover, press and keyboard focus. -->
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="HeaderIconChrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HeaderIconChrome" Property="Background" Value="{DynamicResource SelectionBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="HeaderIconChrome" Property="Background" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="HeaderIconChrome" Property="Background" Value="{DynamicResource GhostBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource DisabledBrush}"/>
                                <Setter Property="Opacity" Value="0.45"/>
                                <Setter TargetName="HeaderIconChrome" Property="Background" Value="Transparent"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Only the flat window-options menu owns these templates. Other WPF menus and
             the WinForms tray menu keep their existing icon/submenu behavior. Tag carries
             WPF's live high-contrast resource inside this separate Popup only. -->
        <Style x:Key="FlyoutOptionsContextMenu" TargetType="ContextMenu">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="MinWidth" Value="160"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Tag" Value="{DynamicResource {x:Static SystemParameters.HighContrastKey}}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border x:Name="OptionsMenuChrome" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}" CornerRadius="8">
                            <ScrollViewer CanContentScroll="True" HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto">
                                <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.MenuBrushKey}}"/>
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.MenuTextBrushKey}}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.MenuTextBrushKey}}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="FlyoutOptionsMenuItem" TargetType="MenuItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Tag" Value="{Binding Tag, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"/>
            <!-- Focus is drawn once by the item's own border, rather than a second adorner. -->
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="OptionsItemChrome" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}" CornerRadius="5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Path x:Name="OptionsCheck" Width="12" Height="10" Stretch="Uniform"
                                      Data="M 1,5 L 4,8 L 10,1" Stroke="{TemplateBinding Foreground}"
                                      StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Visibility="Hidden"/>
                                <ContentPresenter Grid.Column="2" ContentSource="Header" RecognizesAccessKey="True"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="OptionsCheck" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="{DynamicResource GhostBrush}"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="Background" Value="{DynamicResource GhostBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                </Trigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.MenuBrushKey}}"/>
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.MenuTextBrushKey}}"/>
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True"/>
                        <Condition Binding="{Binding IsHighlighted, RelativeSource={RelativeSource Self}}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/>
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True"/>
                        <Condition Binding="{Binding IsKeyboardFocused, RelativeSource={RelativeSource Self}}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/>
                </MultiDataTrigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource DisabledBrush}"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderBrush" Value="Transparent"/>
                </Trigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True"/>
                        <Condition Binding="{Binding IsEnabled, RelativeSource={RelativeSource Self}}" Value="False"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="FlyoutOptionsSeparator" TargetType="Separator">
            <Setter Property="Background" Value="{DynamicResource LineBrush}"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Tag" Value="{Binding Tag, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border x:Name="OptionsSeparatorLine" Height="1" Margin="8,3"
                                Background="{TemplateBinding Background}" SnapsToDevicePixels="True"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.MenuTextBrushKey}}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="UsagePeriodChoice" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="PeriodChrome" Padding="12,5" Background="Transparent" BorderThickness="0,0,0,2" BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PeriodChrome" Property="Background" Value="{DynamicResource SelectionBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter TargetName="PeriodChrome" Property="BorderBrush" Value="{DynamicResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="PeriodChrome" Property="Background" Value="{DynamicResource SelectionBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="UsageRingButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RingChrome" Padding="5" Background="Transparent" BorderThickness="1" BorderBrush="Transparent" CornerRadius="8">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RingChrome" Property="Background" Value="{DynamicResource GhostBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="RingChrome" Property="BorderBrush" Value="{DynamicResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- A secondary action inside the detail card: text only, underlined on hover and focus. -->
        <Style x:Key="FlyoutLinkButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="0,2">
                            <TextBlock x:Name="LinkText" Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="LinkText" Property="TextDecorations" Value="Underline"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="LinkText" Property="TextDecorations" Value="Underline"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <!-- Darkest ground for the popup; the detail card and account rows sit one step lighter. -->
    <Border x:Name="FlyoutSurface" Width="440" Background="{DynamicResource BgBrush}"
            BorderBrush="{DynamicResource LineBrush}"
            BorderThickness="1"
            CornerRadius="14"
            Padding="0"
            ClipToBounds="True">
        <Border.LayoutTransform>
            <ScaleTransform x:Name="FlyoutScale" ScaleX="1" ScaleY="1"/>
        </Border.LayoutTransform>
        <DockPanel>
            <Grid x:Name="FlyoutHeaderGrid"
                  DockPanel.Dock="Top"
                  Margin="14,14,14,8"
                  MouseLeftButtonDown="OnHeaderMouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*" MinWidth="0"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <Border Background="{DynamicResource GhostBrush}" CornerRadius="9" Width="28" Height="28" Margin="0,0,10,0">
                        <Viewbox Width="20" Height="20" Stretch="Uniform">
                            <Canvas Width="24" Height="24">
                                <Path x:Name="HeaderLogoPath" Stroke="{DynamicResource TextBrush}" StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M17,18 A8,8 0 1 1 12,4"/>
                                <Ellipse Canvas.Left="16" Canvas.Top="0" Width="6" Height="6" Fill="{DynamicResource AccentBrush}"/>
                            </Canvas>
                        </Viewbox>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText" Text="{x:Static text:UiText.ProductName}" FontWeight="SemiBold" FontSize="16" Foreground="{DynamicResource TextBrush}"/>
                        <TextBlock x:Name="VersionText" FontSize="9" Foreground="{DynamicResource MutedBrush}"/>
                    </StackPanel>
                </StackPanel>

                <Label x:Name="StatusIndicator" Grid.Column="1" Width="20" Height="28" Padding="0"
                       Margin="0,0,12,0" HorizontalAlignment="Left" Background="Transparent"
                       HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                    <Grid>
                    <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{DynamicResource OkBrush}" Visibility="Collapsed"/>
                    <Path x:Name="StatusWarningIcon" Width="14" Height="14" Stretch="Uniform"
                          Stroke="{DynamicResource StaleBrush}" StrokeThickness="1.4"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Data="M7,1 L13,12 L1,12 Z M7,4.5 L7,7.5 M7,9.5 L7,9.6" Visibility="Collapsed"/>
                    <Path x:Name="StatusPendingIcon" Width="14" Height="14" Stretch="Uniform"
                          Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.4"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M13,7 A6,6 0 1 1 1,7 A6,6 0 1 1 13,7 M7,3.5 L7,7 L9.5,8.5"/>
                    </Grid>
                </Label>
                <Button x:Name="FlyoutZoomOutButton" Grid.Column="2"
                        Style="{StaticResource FlyoutHeaderIconButton}"
                        Click="OnZoomOutClick" Margin="0,0,4,0">
                    <Path x:Name="FlyoutZoomOutIcon" Width="16" Height="16"
                          Stroke="{DynamicResource TextBrush}" StrokeThickness="1.4"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M10.5,6 A4.5,4.5 0 1 1 1.5,6 A4.5,4.5 0 1 1 10.5,6 M9.3,9.3 L14,14 M3.75,6 L8.25,6"/>
                </Button>
                <TextBlock x:Name="FlyoutZoomPercentText" Grid.Column="3" Text="100%" Width="34" Height="16" Margin="0,0,4,0"
                           FontSize="10.5" TextAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource MutedBrush}" Typography.NumeralAlignment="Tabular"/>
                <Button x:Name="FlyoutZoomInButton" Grid.Column="4"
                        Style="{StaticResource FlyoutHeaderIconButton}"
                        Click="OnZoomInClick" Margin="0,0,4,0">
                    <Path x:Name="FlyoutZoomInIcon" Width="16" Height="16"
                          Stroke="{DynamicResource TextBrush}" StrokeThickness="1.4"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M10.5,6 A4.5,4.5 0 1 1 1.5,6 A4.5,4.5 0 1 1 10.5,6 M9.3,9.3 L14,14 M3.75,6 L8.25,6 M6,3.75 L6,8.25"/>
                </Button>
                <Button x:Name="RefreshAllButton"
                        Grid.Column="5"
                        Style="{StaticResource FlyoutHeaderIconButton}"
                        Click="OnRefreshAllClick"
                        ToolTip="Refresh all"
                        ToolTipService.ShowOnDisabled="True"
                        AutomationProperties.Name="Refresh all"
                        Margin="0,0,4,0">
                    <Grid Width="18" Height="18">
                        <Path x:Name="RefreshAllIcon" Width="18" Height="18" Stretch="Uniform"
                              Stroke="{DynamicResource TextBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M17,7 A7,7 0 0 0 4,4 M17,2 L17,7 L12,7 M3,13 A7,7 0 0 0 16,16 M3,18 L3,13 L8,13"/>
                        <Viewbox x:Name="RefreshSpinner"
                                 Width="16"
                                 Height="16"
                                 Stretch="Uniform"
                                 Visibility="Collapsed"
                                 RenderTransformOrigin="0.5,0.5">
                            <Viewbox.RenderTransform>
                                <RotateTransform x:Name="RefreshSpinnerRotate" Angle="0"/>
                            </Viewbox.RenderTransform>
                            <Path Stroke="{DynamicResource AccentBrush}"
                                  StrokeThickness="2.2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Fill="Transparent"
                                  Stretch="None"
                                  Width="16"
                                  Height="16">
                                <Path.Data>
                                    <PathGeometry>
                                        <PathFigure StartPoint="14,8" IsClosed="False">
                                            <ArcSegment Point="8,2"
                                                        Size="6,6"
                                                        SweepDirection="Clockwise"
                                                        IsLargeArc="True"
                                                        IsStroked="True"/>
                                        </PathFigure>
                                    </PathGeometry>
                                </Path.Data>
                            </Path>
                        </Viewbox>
                    </Grid>
                </Button>
                <Button x:Name="SettingsButton" Grid.Column="6"
                        Style="{StaticResource FlyoutHeaderIconButton}" Click="OnSettingsClick" Margin="0,0,4,0">
                    <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                               Foreground="{DynamicResource TextBrush}"/>
                </Button>
                <Button x:Name="WindowOptionsButton"
                        Grid.Column="7"
                        Style="{StaticResource FlyoutHeaderIconButton}"
                        Click="OnWindowOptionsClick" Margin="0,0,4,0">
                    <Button.ContextMenu>
                        <ContextMenu x:Name="WindowOptionsMenu" Style="{StaticResource FlyoutOptionsContextMenu}">
                            <MenuItem x:Name="PinMenuItem" Style="{StaticResource FlyoutOptionsMenuItem}" IsCheckable="True" Click="OnPinClick"/>
                            <Separator Style="{StaticResource FlyoutOptionsSeparator}"/>
                            <MenuItem x:Name="CloseFlyoutMenuItem" Style="{StaticResource FlyoutOptionsMenuItem}" Click="OnCloseClick"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                    <Path Width="16" Height="16" Stretch="Uniform" Stroke="{DynamicResource TextBrush}"
                          StrokeThickness="2.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M2,8 L2.1,8 M8,8 L8.1,8 M14,8 L14.1,8"/>
                </Button>
                <Button x:Name="CloseButton" Grid.Column="8"
                        Style="{StaticResource FlyoutHeaderIconButton}" Click="OnCloseClick">
                    <Path x:Name="CloseIcon" Width="14" Height="14"
                          Stroke="{DynamicResource TextBrush}" StrokeThickness="1.4"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M3,3 L11,11 M11,3 L3,11"/>
                </Button>
            </Grid>
            <ScrollViewer x:Name="FlyoutContentScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="14,4,14,14" MaxHeight="640">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <ContentControl x:Name="SelectedAvatarHost" DockPanel.Dock="Left" Margin="0,0,9,0"
                                        VerticalAlignment="Center" Focusable="False" IsTabStop="False"/>
                        <Grid x:Name="SelectedAccountHeader" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="SelectedAccountText" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" Margin="0,0,8,0" Visibility="Collapsed" Foreground="{DynamicResource TextBrush}"/>
                            <ComboBox x:Name="AccountSelector" Margin="0,0,8,0" MinHeight="32" FontSize="13"
                                      MaxDropDownHeight="240" Visibility="Collapsed" SelectedValuePath="Id"
                                      SelectionChanged="OnAccountSelectorChanged">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <ui:UsageProviderBadge x:Name="SelectedProviderBadge" Grid.Column="1"/>
                        </Grid>
                    </DockPanel>
                    <Border x:Name="CodexCard" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="12">
                        <StackPanel>
                            <!-- One line: the shared scope, and the official usage page as a link. The title
                                 stays as the header's accessible name; the provider badge already names Claude. -->
                            <DockPanel x:Name="ClaudeUsageHeader" Visibility="Collapsed" Margin="0,0,0,8" LastChildFill="True">
                                <TextBlock x:Name="ClaudeUsageTitle" Visibility="Collapsed"/>
                                <Button x:Name="ClaudeUsagePageButton" DockPanel.Dock="Right" Style="{StaticResource FlyoutLinkButton}"
                                        Click="OnClaudeUsagePage" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="ClaudeUsageScope" Foreground="{DynamicResource MutedBrush}" FontSize="11"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            </DockPanel>
                            <TextBlock x:Name="CodexStatusText" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8" Visibility="Collapsed"/>
                            <StackPanel Margin="0,0,0,12">
                                <DockPanel LastChildFill="False">
                                    <TextBlock x:Name="UsagePeriodLabel" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextBrush}" Margin="0,0,12,0"/>
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="AutoPeriodButton" GroupName="UsagePeriod" Style="{StaticResource UsagePeriodChoice}" Checked="OnUsagePeriodChecked"/>
                                        <RadioButton x:Name="FiveHourPeriodButton" GroupName="UsagePeriod" Style="{StaticResource UsagePeriodChoice}" Checked="OnUsagePeriodChecked"/>
                                        <RadioButton x:Name="WeeklyPeriodButton" GroupName="UsagePeriod" Style="{StaticResource UsagePeriodChoice}" Checked="OnUsagePeriodChecked"/>
                                    </StackPanel>
                                </DockPanel>
                                <TextBlock x:Name="UsagePeriodHint" FontSize="11" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                <TextBlock x:Name="UsagePeriodFallback" FontSize="11" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed"/>
                            </StackPanel>
                            <!-- The ring and the limit it shows share the top row; every other limit and
                                 the check time run full width below, so the ring never floats in a tall column. -->
                            <Grid x:Name="CodexBodyGrid">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <Button x:Name="CyclePeriodButton" Style="{StaticResource UsageRingButton}" Click="OnCyclePeriodClick" HorizontalAlignment="Center">
                                        <Grid x:Name="CodexRingHost" Width="112" Height="112">
                                            <Ellipse x:Name="CodexRingTrack" Width="112" Height="112" StrokeThickness="10" Stroke="{DynamicResource LineBrush}"/>
                                            <Path x:Name="CodexRingArcPath" StrokeThickness="10" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stroke="{DynamicResource AccentBrush}" Fill="Transparent" Visibility="Collapsed">
                                                <Path.Data><PathGeometry><PathFigure x:Name="CodexRingFigure" IsClosed="False"><ArcSegment x:Name="CodexRingArcSegment" SweepDirection="Clockwise"/></PathFigure></PathGeometry></Path.Data>
                                            </Path>
                                            <Ellipse x:Name="CodexRingFullCircle" Width="112" Height="112" StrokeThickness="10" Stroke="{DynamicResource AccentBrush}" Visibility="Collapsed"/>
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <!-- Leaves side room inside the ring for two-decimal values such as 23.09%. -->
                                                <Viewbox MaxWidth="84" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Center">
                                                    <TextBlock x:Name="CodexRingValueText" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{DynamicResource TextBrush}"/>
                                                </Viewbox>
                                                <TextBlock x:Name="CodexRingSubLabel" FontSize="11" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="96" Margin="0,4,0,0" Foreground="{DynamicResource MutedBrush}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </StackPanel>
                                <Border Grid.Column="1" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1,0,0,0" Padding="12,0,0,0" Margin="4,0,0,0">
                                    <Grid>
                                        <ItemsControl x:Name="CodexRows" VerticalAlignment="Center"/>
                                        <!-- Without a known limit the ring's side still says why it is empty. -->
                                        <TextBlock x:Name="CodexRowsEmptyText" VerticalAlignment="Center" TextWrapping="Wrap"
                                                   FontSize="12" Foreground="{DynamicResource MutedBrush}" Visibility="Collapsed"/>
                                    </Grid>
                                </Border>
                                <Border x:Name="CodexSecondaryRowsHost" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,10,0,0"
                                        BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Visibility="Collapsed">
                                    <ItemsControl x:Name="CodexSecondaryRows"/>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border x:Name="UsageCreditsCard" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="12,8" Margin="0,10,0,0" Visibility="Collapsed">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock x:Name="UsageCreditsTitle" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}"/>
                                <Path x:Name="UsageCreditsWarning" Grid.Column="1" Width="12" Height="12" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" Stretch="Uniform" Stroke="{DynamicResource StaleBrush}" StrokeThickness="1.2" StrokeLineJoin="Round" Data="M6,1 L11,11 L1,11 Z M6,4 L6,7 M6,8.5 L6,9"/>
                                <TextBlock x:Name="UsageCreditsSummary" Grid.Column="2" Margin="10,0,8,0" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextBrush}"/>
                                <Button x:Name="UsageCreditsExpandButton" Grid.Column="3" Style="{StaticResource FlyoutHeaderIconButton}" Background="Transparent" Click="OnUsageCardExpandClick">
                                    <Path x:Name="UsageCreditsChevron" Width="12" Height="7" Stretch="Uniform" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M1,1 L7,7 L13,1"/>
                                </Button>
                            </Grid>
                            <StackPanel x:Name="UsageCreditsDetails" Margin="0,6,0,0" Visibility="Collapsed">
                                <TextBlock x:Name="UsageCreditsNotice" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,6" Visibility="Collapsed" Foreground="{DynamicResource StaleBrush}"/>
                                <ItemsControl x:Name="UsageCreditsRows"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <!-- One line while folded: count and the nearest expiry. Expanding shows each credit and its action. -->
                    <Border x:Name="ResetCreditsCard" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="12,8" Margin="0,10,0,0">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock x:Name="ResetCreditsTitle" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}"/>
                                <Border Grid.Column="1" Background="{DynamicResource LineBrush}" CornerRadius="10" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <Button x:Name="CreditHelpButton" Style="{StaticResource FlyoutHeaderIconButton}" Background="Transparent" Padding="8,0" MinHeight="22" Click="OnCreditHelpClick">
                                        <TextBlock x:Name="ResetCreditsCount" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                                    </Button>
                                </Border>
                                <TextBlock x:Name="CreditSummaryText" Grid.Column="2" Margin="10,0,8,0" FontSize="12" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" Foreground="{DynamicResource MutedBrush}"/>
                                <Button x:Name="CreditExpandButton" Grid.Column="3" HorizontalAlignment="Right" Style="{StaticResource FlyoutHeaderIconButton}" Background="Transparent" Click="OnCreditExpandClick">
                                    <Path x:Name="CreditExpandChevron" Width="12" Height="7" Stretch="Uniform" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M1,7 L7,1 L13,7"/>
                                </Button>
                            </Grid>
                            <StackPanel x:Name="CreditDetails" Margin="0,8,0,0">
                            <Border x:Name="CreditListBorder" Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="12,0">
                                <ScrollViewer x:Name="CreditExpiryScroll" MaxHeight="108" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                                    <ItemsControl x:Name="CreditExpiryRows"/>
                                </ScrollViewer>
                            </Border>
                            <TextBlock x:Name="CreditExpiryNotice" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <!-- Selected account first; the account list below keeps its order and compares all. -->
                    <StackPanel x:Name="AccountSection" Visibility="Collapsed" Margin="0,16,0,0">
                        <DockPanel Margin="0,0,0,8">
                            <Button x:Name="ManageAccountsButton" DockPanel.Dock="Right" Style="{StaticResource CreditUseButton}"
                                    Padding="10,5" Click="OnAccountsClick"/>
                            <TextBlock x:Name="AccountsHeading" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </DockPanel>
                        <ItemsControl x:Name="AccountOverview" Grid.IsSharedSizeScope="True"/>
                        <TextBlock x:Name="AccountSelectionHint" FontSize="11" Foreground="{DynamicResource MutedBrush}"
                                   TextWrapping="Wrap" Margin="0,2,0,8"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
