<Window x:Class="CycleArc.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Width="640" Height="624" MinWidth="580" MinHeight="480"
        WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
        Style="{StaticResource AppWindow}" PreviewKeyDown="OnPreviewKeyDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="60" ResizeBorderThickness="6" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="SettingsAction" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource ControlFocusVisual}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.9"/></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value="0.75"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SettingsHeading" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontSize" Value="20"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="SettingsHint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/><Setter Property="LineHeight" Value="19"/>
        </Style>
        <Style x:Key="SettingsRow" TargetType="Grid">
            <Setter Property="MinHeight" Value="58"/><Setter Property="Margin" Value="0,2"/>
        </Style>
        <Style x:Key="SettingsChoice" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="MinHeight" Value="36"/><Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource ControlFocusVisual}"/>
        </Style>
        <Style x:Key="SettingsSwitch" TargetType="CheckBox">
            <Setter Property="Width" Value="44"/><Setter Property="Height" Value="30"/>
            <Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{StaticResource ControlFocusVisual}"/>
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Border x:Name="Track" Height="24" CornerRadius="12" Background="{DynamicResource ControlBrush}" BorderBrush="{DynamicResource MutedBrush}" BorderThickness="1">
                            <Ellipse x:Name="Knob" Width="16" Height="16" Fill="{DynamicResource TextBrush}" HorizontalAlignment="Left" Margin="3"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}"/>
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource OnAccentBrush}"/>
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource TextBrush}"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Knob" Property="Opacity" Value="0.7"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Track" Property="Opacity" Value="0.5"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TabItem" x:Key="SettingsNavItem">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource ControlFocusVisual}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
                <Border x:Name="NavChrome" CornerRadius="8" Background="{TemplateBinding Background}" Padding="14,11">
                    <ContentPresenter ContentSource="Header" TextBlock.Foreground="{TemplateBinding Foreground}"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource GhostBrush}"/></Trigger>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="{DynamicResource GhostBrush}"/>
                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource DisabledBrush}"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="Slider">
            <Setter Property="Height" Value="30"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource ControlFocusVisual}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider">
                <Grid Background="Transparent" Margin="7,0">
                    <Border Height="4" CornerRadius="2" Background="{DynamicResource LineBrush}"/>
                    <Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" Orientation="Horizontal">
                        <Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="4" Background="{DynamicResource AccentBrush}" CornerRadius="2"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
                        <Track.Thumb><Thumb Width="14" Height="14"><Thumb.Template><ControlTemplate TargetType="Thumb"><Ellipse Fill="{DynamicResource AccentBrush}" Stroke="{DynamicResource CardBrush}" StrokeThickness="2"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
                        <Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
                    </Track>
                </Grid>
                <ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
                <Track x:Name="PART_Track" Width="8" IsDirectionReversed="True" Orientation="Vertical" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}">
                    <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb">
                        <Border Background="{DynamicResource MutedBrush}" CornerRadius="3" Margin="2,0"/>
                    </ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
                </Track>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Background="{DynamicResource BgBrush}">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="60"/><RowDefinition Height="*"/><RowDefinition Height="72"/></Grid.RowDefinitions>
            <Grid Margin="24,0,12,0">
                <TextBlock x:Name="WindowHeading" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Button x:Name="CloseSettingsButton" HorizontalAlignment="Right" Width="40" Height="36" Padding="0" Style="{StaticResource SettingsAction}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="OnCancel">
                    <Path Width="12" Height="12" Data="M0,0 L12,12 M12,0 L0,12" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.5"/>
                </Button>
            </Grid>
            <TabControl x:Name="SettingsTabs" Grid.Row="1" TabStripPlacement="Left" ItemContainerStyle="{StaticResource SettingsNavItem}" BorderThickness="0">
                <TabControl.Template><ControlTemplate TargetType="TabControl">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="128"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,1,1">
                            <StackPanel IsItemsHost="True" Margin="12,16" KeyboardNavigation.TabNavigation="Once"/>
                        </Border>
                        <Border Grid.Column="1" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,1">
                            <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" Margin="28,24"/>
                        </Border>
                    </Grid>
                </ControlTemplate></TabControl.Template>
                <TabItem x:Name="GeneralTab">
                    <ScrollViewer FontWeight="Normal" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
                        <StackPanel>
                            <TextBlock x:Name="AppearanceTitle" Style="{StaticResource SettingsHeading}"/>
                            <TextBlock x:Name="AppearanceHint" Style="{StaticResource SettingsHint}" Margin="0,0,0,18"/>
                            <Grid Style="{StaticResource SettingsRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="184"/></Grid.ColumnDefinitions>
                                <TextBlock x:Name="ThemeLabel" VerticalAlignment="Center"/><ComboBox x:Name="ThemeBox" Grid.Column="1" Style="{StaticResource SettingsChoice}"/>
                            </Grid>
                            <Grid Style="{StaticResource SettingsRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="184"/></Grid.ColumnDefinitions>
                                <TextBlock x:Name="LanguageLabel" VerticalAlignment="Center"/><ComboBox x:Name="LanguageBox" Grid.Column="1" Style="{StaticResource SettingsChoice}"/>
                            </Grid>
                            <Grid Style="{StaticResource SettingsRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="184"/></Grid.ColumnDefinitions>
                                <TextBlock x:Name="IconLabel" VerticalAlignment="Center"/><ComboBox x:Name="IconBox" Grid.Column="1" Style="{StaticResource SettingsChoice}"/>
                            </Grid>
                            <Border Height="1" Background="{DynamicResource LineBrush}" Margin="0,12"/>
                            <Grid Style="{StaticResource SettingsRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock x:Name="StartupLabel" VerticalAlignment="Center"/><CheckBox x:Name="StartupBox" Grid.Column="1" Style="{StaticResource SettingsSwitch}"/>
                            </Grid>
                            <TextBlock x:Name="TrayHint" Style="{StaticResource SettingsHint}" Margin="0,14,0,0"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem x:Name="WidgetTab">
                    <ScrollViewer FontWeight="Normal" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
                        <StackPanel>
                            <TextBlock x:Name="WidgetTitle" Style="{StaticResource SettingsHeading}"/>
                            <TextBlock x:Name="WidgetHint" Style="{StaticResource SettingsHint}" Margin="0,0,0,18"/>
                            <Grid Style="{StaticResource SettingsRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock x:Name="WidgetLabel" VerticalAlignment="Center"/><CheckBox x:Name="WidgetBox" Grid.Column="1" Style="{StaticResource SettingsSwitch}"/>
                            </Grid>
                            <Border Height="1" Background="{DynamicResource LineBrush}" Margin="0,12"/>
                            <StackPanel IsEnabled="{Binding IsChecked, ElementName=WidgetBox}">
                                <Grid Style="{StaticResource SettingsRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock x:Name="WidgetTopLabel" VerticalAlignment="Center"/><CheckBox x:Name="WidgetTopBox" Grid.Column="1" Style="{StaticResource SettingsSwitch}"/>
                                </Grid>
                                <Grid Style="{StaticResource SettingsRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock x:Name="WidgetClickThroughLabel" VerticalAlignment="Center"/><CheckBox x:Name="WidgetClickThroughBox" Grid.Column="1" Style="{StaticResource SettingsSwitch}"/>
                                </Grid>
                                <Grid Margin="0,20,0,8"><TextBlock x:Name="WidgetOpacityLabel"/><TextBlock x:Name="WidgetOpacityValue" HorizontalAlignment="Right" Foreground="{DynamicResource MutedBrush}"/></Grid>
                                <Slider x:Name="WidgetOpacityBox" Minimum="0.25" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" ValueChanged="OnOpacityChanged"/>
                            </StackPanel>
                            <Button x:Name="ResetWidgetPositionButton" Style="{StaticResource SettingsAction}"
                                    HorizontalAlignment="Left" Margin="0,20,0,0" Click="OnResetWidgetPosition"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem x:Name="ConnectionTab">
                    <ScrollViewer FontWeight="Normal" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
                        <StackPanel>
                            <TextBlock x:Name="CodexTitle" Style="{StaticResource SettingsHeading}"/>
                            <TextBlock x:Name="CodexHint" Style="{StaticResource SettingsHint}" Margin="0,0,0,12"/>
                            <TextBlock x:Name="ConnectionSteps" Style="{StaticResource SettingsHint}" Margin="0,0,0,16"/>
                            <Button x:Name="ManageAccountsButton" Style="{StaticResource SettingsAction}" HorizontalAlignment="Left" Margin="0,0,0,16" Click="OnAccounts"/>
                            <TextBlock x:Name="CodexExeLabel" Margin="0,0,0,10"/>
                            <Grid>
                                <TextBox x:Name="CodexExeBox" MinHeight="38" Padding="10,8"/>
                                <TextBlock x:Name="AutoDetectHint" Margin="12,0" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" IsHitTestVisible="False">
                                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=CodexExeBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                    </Style></TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <TextBlock x:Name="CodexPathHint" Style="{StaticResource SettingsHint}" Margin="0,10,0,0"/>
                            <Border Height="1" Background="{DynamicResource LineBrush}" Margin="0,28"/>
                            <Grid Style="{StaticResource SettingsRow}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="184"/></Grid.ColumnDefinitions>
                                <TextBlock x:Name="RefreshScheduleTitle" VerticalAlignment="Center"/>
                                <ComboBox x:Name="RefreshIntervalBox" Grid.Column="1" Style="{StaticResource SettingsChoice}"/>
                            </Grid>
                            <TextBlock x:Name="RefreshScheduleHint" Style="{StaticResource SettingsHint}"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
            <Grid Grid.Row="2" Margin="24,0">
                <Button x:Name="LogsButton" Style="{StaticResource SettingsAction}" HorizontalAlignment="Left" VerticalAlignment="Center" Click="OnOpenLogs"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="CancelButton" Style="{StaticResource SettingsAction}" Click="OnCancel" MinWidth="76" Margin="0,0,8,0"/>
                    <Button x:Name="SaveButton" Style="{StaticResource SettingsAction}" Background="{DynamicResource AccentSoftBrush}" Foreground="{DynamicResource OnAccentBrush}" Click="OnSave" MinWidth="76"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
