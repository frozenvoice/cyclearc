<Window x:Class="CycleArc.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Width="780" Height="750" MinWidth="640" MinHeight="480"
        WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
        Style="{StaticResource AppWindow}" PreviewKeyDown="OnPreviewKeyDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="52" ResizeBorderThickness="6" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="SettingsAction" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource ControlFocusVisual}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.9"/></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value="0.75"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SettingsHeading" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontSize" Value="26"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="SettingsHint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/><Setter Property="LineHeight" Value="19"/>
        </Style>
        <Style x:Key="SettingsRow" TargetType="Grid">
            <Setter Property="MinHeight" Value="56"/><Setter Property="Margin" Value="16,0"/>
        </Style>
        <Style x:Key="SettingsLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="SettingsSection" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,16,0,10"/>
        </Style>
        <Style x:Key="SettingsGroup" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/>
        </Style>
        <Style x:Key="SettingsDivider" TargetType="Border">
            <Setter Property="Height" Value="1"/><Setter Property="Margin" Value="16,0"/>
            <Setter Property="Background" Value="{DynamicResource LineBrush}"/>
        </Style>
        <Style x:Key="SettingsChoice" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="MinHeight" Value="36"/><Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource ControlFocusVisual}"/>
        </Style>
        <!-- Actual theme choices, with a miniature window that communicates each appearance. -->
        <Style x:Key="ThemeChoice" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource ControlFocusVisual}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                <Border x:Name="Choice" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,0,8,0">
                    <StackPanel>
                        <Border x:Name="Screen" Height="48" CornerRadius="4" BorderBrush="#687387" BorderThickness="1" Background="#F3F5F8">
                            <Grid ClipToBounds="True">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border x:Name="ScreenRail" Background="#DDE2EB" CornerRadius="3,0,0,3"/>
                                <StackPanel Grid.Column="1" Margin="8" VerticalAlignment="Center">
                                    <Border x:Name="ScreenLine" Background="#8C96A8" Height="3" Width="26" HorizontalAlignment="Left" CornerRadius="1" Margin="0,0,0,6"/>
                                    <Border x:Name="ScreenPanel" Background="#FFFFFF" Height="14" CornerRadius="2"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Grid Margin="0,8,0,0">
                            <ContentPresenter VerticalAlignment="Center"/>
                            <Path x:Name="SelectedMark" Visibility="Hidden" Data="M0,5 L3,8 L9,1" Stroke="{DynamicResource TextBrush}"
                                  StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="ItemsControl.AlternationIndex" Value="0">
                        <Setter TargetName="ScreenRail" Property="Background" Value="#252A34"/>
                    </Trigger>
                    <Trigger Property="ItemsControl.AlternationIndex" Value="2">
                        <Setter TargetName="Screen" Property="Background" Value="#121418"/>
                        <Setter TargetName="ScreenRail" Property="Background" Value="#252A34"/>
                        <Setter TargetName="ScreenLine" Property="Background" Value="#A6B1C3"/>
                        <Setter TargetName="ScreenPanel" Property="Background" Value="#333C4D"/>
                    </Trigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Choice" Property="BorderBrush" Value="{DynamicResource MutedBrush}"/></Trigger>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter TargetName="Choice" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                        <Setter TargetName="Choice" Property="Background" Value="{DynamicResource PanelBrush}"/>
                        <Setter TargetName="SelectedMark" Property="Visibility" Value="Visible"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="SettingsSwitch" TargetType="CheckBox">
            <Setter Property="Width" Value="44"/><Setter Property="Height" Value="36"/>
            <Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{StaticResource ControlFocusVisual}"/>
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Border x:Name="Track" Height="24" CornerRadius="12" Background="{DynamicResource ControlBrush}" BorderBrush="{DynamicResource MutedBrush}" BorderThickness="1">
                            <Ellipse x:Name="Knob" Width="16" Height="16" Fill="{DynamicResource TextBrush}" HorizontalAlignment="Left" Margin="3"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}"/>
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource OnAccentBrush}"/>
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource TextBrush}"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Knob" Property="Opacity" Value="0.7"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Track" Property="Opacity" Value="0.5"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TabItem" x:Key="SettingsNavItem">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource ControlFocusVisual}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
                <Border x:Name="NavChrome" CornerRadius="8" Background="{TemplateBinding Background}" Padding="12,13">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Path x:Name="NavIcon" Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                              Width="17" Height="17" Stretch="Uniform" Stroke="{TemplateBinding Foreground}"
                              StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        <ContentPresenter Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
                                          ContentSource="Header" TextBlock.Foreground="{TemplateBinding Foreground}"/>
                    </Grid>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource GhostBrush}"/></Trigger>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="{DynamicResource GhostBrush}"/>
                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter TargetName="NavIcon" Property="Stroke" Value="{DynamicResource AccentBrush}"/>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource DisabledBrush}"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="Slider">
            <Setter Property="Height" Value="30"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource ControlFocusVisual}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider">
                <Grid Background="Transparent" Margin="7,0">
                    <Border Height="4" CornerRadius="2" Background="{DynamicResource LineBrush}"/>
                    <Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" Orientation="Horizontal">
                        <Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="4" Background="{DynamicResource AccentBrush}" CornerRadius="2"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
                        <Track.Thumb><Thumb Width="14" Height="14"><Thumb.Template><ControlTemplate TargetType="Thumb"><Ellipse Fill="{DynamicResource AccentBrush}" Stroke="{DynamicResource CardBrush}" StrokeThickness="2"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
                        <Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
                    </Track>
                </Grid>
                <ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
                <Track x:Name="PART_Track" Width="8" IsDirectionReversed="True" Orientation="Vertical" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}">
                    <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb">
                        <Border Background="{DynamicResource MutedBrush}" CornerRadius="3" Margin="2,0"/>
                    </ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
                </Track>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Background="{DynamicResource BgBrush}">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="52"/><RowDefinition Height="*"/><RowDefinition Height="72"/></Grid.RowDefinitions>
            <Grid Margin="20,0,12,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/CycleArc;component/Assets/cyclearc.ico" Width="22" Height="22" Margin="0,0,10,0"/>
                    <TextBlock x:Name="WindowHeading" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <Button x:Name="CloseSettingsButton" HorizontalAlignment="Right" Width="36" Height="32" MinHeight="32" Padding="0"
                        Style="{StaticResource SettingsAction}" Background="Transparent"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="OnCancel">
                    <Path Width="10" Height="10" Data="M0,0 L10,10 M10,0 L0,10" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.5"/>
                </Button>
            </Grid>
            <TabControl x:Name="SettingsTabs" Grid.Row="1" TabStripPlacement="Left" ItemContainerStyle="{StaticResource SettingsNavItem}" BorderThickness="0">
                <TabControl.Template><ControlTemplate TargetType="TabControl">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="166"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Background="{DynamicResource CardBrush}" CornerRadius="0,14,0,0">
                            <StackPanel IsItemsHost="True" Margin="12,24" KeyboardNavigation.TabNavigation="Once"/>
                        </Border>
                        <ContentPresenter Grid.Column="1" x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" Margin="28,22,22,20"/>
                    </Grid>
                </ControlTemplate></TabControl.Template>
                <TabItem x:Name="GeneralTab" Tag="M2,4 H18 M2,10 H18 M2,16 H18 M6,1 V7 M14,7 V13 M7,13 V19">
                    <ScrollViewer FontWeight="Normal" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
                        <StackPanel>
                            <TextBlock x:Name="AppearanceTitle" Style="{StaticResource SettingsHeading}"/>
                            <TextBlock x:Name="AppearanceHint" Style="{StaticResource SettingsHint}" Margin="0,0,0,18"/>
                            <TextBlock x:Name="ThemeLabel" Style="{StaticResource SettingsLabel}" Margin="0,0,0,10"/>
                            <ListBox x:Name="ThemeBox" Background="Transparent" BorderThickness="0" Padding="0"
                                     AlternationCount="3" ItemContainerStyle="{StaticResource ThemeChoice}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                     KeyboardNavigation.TabNavigation="Once" Margin="0,0,-8,14">
                                <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ListBox.ItemsPanel>
                            </ListBox>
                            <Border Style="{StaticResource SettingsGroup}">
                                <StackPanel>
                                    <Grid Style="{StaticResource SettingsRow}">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="176"/></Grid.ColumnDefinitions>
                                        <TextBlock x:Name="LanguageLabel" Style="{StaticResource SettingsLabel}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                        <ComboBox x:Name="LanguageBox" Grid.Column="1" Style="{StaticResource SettingsChoice}"/>
                                    </Grid>
                                    <Border Style="{StaticResource SettingsDivider}"/>
                                    <Grid Style="{StaticResource SettingsRow}" MinHeight="72">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="176"/></Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,12,16,12">
                                            <TextBlock x:Name="IconLabel" Style="{StaticResource SettingsLabel}"/>
                                            <TextBlock x:Name="TraySummary" Style="{StaticResource SettingsHint}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <ComboBox x:Name="IconBox" Grid.Column="1" Style="{StaticResource SettingsChoice}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <TextBlock x:Name="BehaviorTitle" Style="{StaticResource SettingsSection}"/>
                            <Border Style="{StaticResource SettingsGroup}">
                                <StackPanel>
                                    <Grid Style="{StaticResource SettingsRow}">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock x:Name="StartupLabel" Style="{StaticResource SettingsLabel}" VerticalAlignment="Center" Margin="0,12,16,12"/>
                                        <CheckBox x:Name="StartupBox" Grid.Column="1" Style="{StaticResource SettingsSwitch}" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Border Style="{StaticResource SettingsDivider}"/>
                                    <Grid Style="{StaticResource SettingsRow}" MinHeight="72">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,12,16,12">
                                            <TextBlock x:Name="EdgeSnapLabel" Style="{StaticResource SettingsLabel}"/>
                                            <TextBlock x:Name="EdgeSnapHint" Style="{StaticResource SettingsHint}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <CheckBox x:Name="EdgeSnapBox" Grid.Column="1" Style="{StaticResource SettingsSwitch}" VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Expander x:Name="TrayDetails" Margin="0,10,0,0">
                                <TextBlock x:Name="TrayHint" Style="{StaticResource SettingsHint}" Margin="8,0,8,4"/>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem x:Name="WidgetTab" Tag="M1,1 H19 V19 H1 Z M1,7 H19 M8,7 V19">
                    <ScrollViewer FontWeight="Normal" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
                        <StackPanel>
                            <TextBlock x:Name="WidgetTitle" Style="{StaticResource SettingsHeading}"/>
                            <TextBlock x:Name="WidgetHint" Style="{StaticResource SettingsHint}" Margin="0,0,0,24"/>
                            <Border Style="{StaticResource SettingsGroup}" Background="{DynamicResource PanelBrush}">
                                <Grid Margin="18,16">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,16,0">
                                        <TextBlock x:Name="WidgetLabel" Style="{StaticResource SettingsLabel}" FontSize="16"/>
                                        <TextBlock x:Name="WidgetEnabledHint" Style="{StaticResource SettingsHint}" Margin="0,6,0,0"/>
                                    </StackPanel>
                                    <CheckBox x:Name="WidgetBox" Grid.Column="1" Style="{StaticResource SettingsSwitch}" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <TextBlock x:Name="WidgetBehaviorTitle" Style="{StaticResource SettingsSection}"/>
                            <StackPanel IsEnabled="{Binding IsChecked, ElementName=WidgetBox}">
                                <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers>
                                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
                                </Style.Triggers></Style></StackPanel.Style>
                                <Border Style="{StaticResource SettingsGroup}">
                                    <StackPanel>
                                        <Grid Style="{StaticResource SettingsRow}">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock x:Name="WidgetTopLabel" Style="{StaticResource SettingsLabel}" VerticalAlignment="Center" Margin="0,12,16,12"/>
                                            <CheckBox x:Name="WidgetTopBox" Grid.Column="1" Style="{StaticResource SettingsSwitch}" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Border Style="{StaticResource SettingsDivider}"/>
                                        <Grid Style="{StaticResource SettingsRow}" MinHeight="82">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Margin="0,12,16,12">
                                                <TextBlock x:Name="WidgetClickThroughLabel" Style="{StaticResource SettingsLabel}"/>
                                                <TextBlock x:Name="WidgetClickThroughHint" Style="{StaticResource SettingsHint}" Margin="0,4,0,0"/>
                                            </StackPanel>
                                            <CheckBox x:Name="WidgetClickThroughBox" Grid.Column="1" Style="{StaticResource SettingsSwitch}" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Border Style="{StaticResource SettingsDivider}"/>
                                        <StackPanel Margin="16,16,16,12">
                                            <Grid>
                                                <TextBlock x:Name="WidgetOpacityLabel" Style="{StaticResource SettingsLabel}"/>
                                                <TextBlock x:Name="WidgetOpacityValue" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                                            </Grid>
                                            <Slider x:Name="WidgetOpacityBox" Minimum="0.25" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True"
                                                    ValueChanged="OnOpacityChanged" Margin="0,10,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <Grid Margin="0,22,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock x:Name="ResetWidgetHint" Style="{StaticResource SettingsHint}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                <Button x:Name="ResetWidgetPositionButton" Grid.Column="1" Style="{StaticResource SettingsAction}" Click="OnResetWidgetPosition"/>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem x:Name="ConnectionTab" Tag="M8,5 L10,3 C13,0 18,2 18,6 C18,8 16,10 14,12 M12,15 L10,17 C7,20 2,18 2,14 C2,12 4,10 6,8 M7,13 L13,7">
                    <ScrollViewer FontWeight="Normal" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
                        <StackPanel>
                            <TextBlock x:Name="ConnectionTitle" Style="{StaticResource SettingsHeading}"/>
                            <TextBlock x:Name="ConnectionHint" Style="{StaticResource SettingsHint}" Margin="0,0,0,24"/>
                            <Border Style="{StaticResource SettingsGroup}" Padding="18" Background="{DynamicResource PanelBrush}">
                                <StackPanel>
                                    <TextBlock Text="Codex · Claude · Cursor" FontSize="18" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="AccountSummary" Style="{StaticResource SettingsHint}" Margin="0,8,0,16"/>
                                    <Button x:Name="ManageAccountsButton" Style="{StaticResource SettingsAction}" HorizontalAlignment="Left" Click="OnAccounts"/>
                                </StackPanel>
                            </Border>
                            <TextBlock x:Name="RefreshSectionTitle" Style="{StaticResource SettingsSection}"/>
                            <Border Style="{StaticResource SettingsGroup}">
                                <StackPanel>
                                    <Grid Style="{StaticResource SettingsRow}">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="176"/></Grid.ColumnDefinitions>
                                        <TextBlock x:Name="RefreshScheduleTitle" Style="{StaticResource SettingsLabel}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                        <ComboBox x:Name="RefreshIntervalBox" Grid.Column="1" Style="{StaticResource SettingsChoice}"/>
                                    </Grid>
                                    <TextBlock x:Name="RefreshScheduleHint" Style="{StaticResource SettingsHint}" Margin="16,0,16,16"/>
                                </StackPanel>
                            </Border>
                            <TextBlock x:Name="CodexTitle" Style="{StaticResource SettingsSection}"/>
                            <Border Style="{StaticResource SettingsGroup}" Padding="16">
                                <StackPanel>
                                    <TextBlock x:Name="CodexExeLabel" Style="{StaticResource SettingsLabel}" Margin="0,0,0,10"/>
                                    <Grid>
                                        <TextBox x:Name="CodexExeBox" MinHeight="38" Padding="10,8"/>
                                        <TextBlock x:Name="AutoDetectHint" Margin="12,0" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" IsHitTestVisible="False">
                                            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=CodexExeBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                            </Style></TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                    <TextBlock x:Name="CodexPathHint" Style="{StaticResource SettingsHint}" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>
                            <Expander x:Name="ConnectionHelp" Margin="0,14,0,0">
                                <StackPanel Margin="8,0,8,4">
                                    <TextBlock x:Name="CodexHint" Style="{StaticResource SettingsHint}" Margin="0,0,0,10"/>
                                    <TextBlock x:Name="ConnectionSteps" Style="{StaticResource SettingsHint}"/>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
            <StackPanel Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="24,0,0,24" MaxWidth="130">
                <TextBlock x:Name="VersionCaption" Style="{StaticResource SettingsHint}" FontSize="11"/>
                <TextBlock x:Name="VersionText" FontSize="14" FontWeight="SemiBold" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>
            <Border Grid.Row="2" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Background="{DynamicResource CardBrush}">
                <Grid Margin="20,0,28,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Button x:Name="LogsButton" Style="{StaticResource SettingsAction}" Background="Transparent" HorizontalAlignment="Left" VerticalAlignment="Center" Click="OnOpenLogs"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="CancelButton" Style="{StaticResource SettingsAction}" Click="OnCancel" MinWidth="88" Margin="0,0,10,0"/>
                        <Button x:Name="SaveButton" Style="{StaticResource SettingsAction}" Background="{DynamicResource AccentSoftBrush}" Foreground="{DynamicResource OnAccentBrush}" Click="OnSave" MinWidth="104"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
