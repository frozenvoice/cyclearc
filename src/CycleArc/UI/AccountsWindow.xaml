<Window x:Class="CycleArc.UI.AccountsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindow}" Width="700" Height="800" MinWidth="470" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" PreviewKeyDown="OnPreviewKeyDown"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize">
    <Window.Resources>
        <Style x:Key="AccountHint" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="LineHeight" Value="19"/>
        </Style>
    </Window.Resources>
    <Border Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="14" Padding="22">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock x:Name="Heading" FontSize="22" FontWeight="SemiBold" MouseLeftButtonDown="OnHeadingDrag"/>
            <TextBlock x:Name="Introduction" Style="{StaticResource AccountHint}" Margin="0,8,0,16"/>
        </StackPanel>
        <ScrollViewer x:Name="AccountsScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,8,0">
                <Expander x:Name="ConnectionOptions" Margin="0,0,0,14">
                <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,8,0,0">
                    <StackPanel>
                        <TextBlock x:Name="NewLoginHeading" FontWeight="SemiBold"/>
                        <TextBlock x:Name="NewLoginHint" Style="{StaticResource AccountHint}" Margin="0,5,0,12"/>
                        <TextBlock x:Name="LabelCaption" FontSize="12" Margin="0,0,0,6"/>
                        <DockPanel>
                            <Button x:Name="AddAccountButton" DockPanel.Dock="Right" Style="{StaticResource CreditUseButton}" Click="OnAdd" Margin="8,0,0,0"/>
                            <Grid>
                                <TextBox x:Name="NewAccountLabel" MaxLength="80" Padding="8,6"/>
                                <TextBlock x:Name="NewLabelExample" Margin="10,0" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" IsHitTestVisible="False">
                                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=NewAccountLabel}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                    </Style></TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </DockPanel>
                        <Border Height="1" Background="{DynamicResource LineBrush}" Margin="0,16"/>
                        <TextBlock x:Name="ExistingHeading" FontWeight="SemiBold"/>
                        <TextBlock x:Name="ExistingHint" Style="{StaticResource AccountHint}" Margin="0,5,0,10"/>
                        <Button x:Name="DiscoverButton" Style="{StaticResource CreditUseButton}" Click="OnDiscover" HorizontalAlignment="Left"/>
                        <Expander x:Name="AdvancedConnection" Margin="0,14,0,0">
                            <StackPanel Margin="4,9,4,0">
                                <TextBlock x:Name="ChooseHomeHint" Style="{StaticResource AccountHint}"/>
                                <Button x:Name="ChooseHomeButton" Style="{StaticResource CreditUseButton}" Click="OnChooseHome" HorizontalAlignment="Left" Margin="0,9,0,0"/>
                            </StackPanel>
                        </Expander>
                        <Border Height="1" Background="{DynamicResource LineBrush}" Margin="0,16"/>
                        <TextBlock x:Name="ClaudeHeading" FontWeight="SemiBold"/>
                        <TextBlock x:Name="ClaudeHint" Style="{StaticResource AccountHint}" Margin="0,5,0,10"/>
                        <TextBlock x:Name="ClaudeLabelCaption" FontSize="12" Margin="0,0,0,6"/>
                        <DockPanel>
                            <Button x:Name="AddClaudeButton" DockPanel.Dock="Right" Style="{StaticResource CreditUseButton}"
                                    Click="OnAddClaude" Margin="8,0,0,0"/>
                            <TextBox x:Name="ClaudeAccountLabel" MaxLength="80" Padding="8,6"/>
                        </DockPanel>
                        <Border Height="1" Background="{DynamicResource LineBrush}" Margin="0,16"/>
                        <TextBlock x:Name="CursorHeading" FontWeight="SemiBold"/>
                        <TextBlock x:Name="CursorHint" Style="{StaticResource AccountHint}" Margin="0,5,0,10"/>
                        <TextBlock x:Name="CursorLabelCaption" FontSize="12" Margin="0,0,0,6"/>
                        <DockPanel>
                            <Button x:Name="AddCursorButton" DockPanel.Dock="Right" Style="{StaticResource CreditUseButton}"
                                    Click="OnAddCursor" Margin="8,0,0,0"/>
                            <TextBox x:Name="CursorAccountLabel" MaxLength="80" Padding="8,6"/>
                        </DockPanel>
                    </StackPanel>
                </Border>
                </Expander>
                <Expander x:Name="AccountHelp" Margin="0,0,0,16">
                    <StackPanel Margin="6,10,6,0">
                        <TextBlock x:Name="ProfileHelp" Style="{StaticResource AccountHint}"/>
                        <TextBlock x:Name="ActionsHelp" Style="{StaticResource AccountHint}" Margin="0,12,0,0"/>
                    </StackPanel>
                </Expander>
                <TextBlock x:Name="AccountsHeading" FontWeight="SemiBold"/>
                <TextBlock x:Name="SelectionHint" Style="{StaticResource AccountHint}" Margin="0,5,0,12"/>
                <TextBlock x:Name="EmptyAccountsHint" Style="{StaticResource AccountHint}" Margin="0,0,0,12" Visibility="Collapsed"/>
                <ItemsControl x:Name="AccountRows"/>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Margin="0,10,0,0">
            <ProgressBar x:Name="OperationProgress" Height="3" IsIndeterminate="True" Visibility="Collapsed"
                         Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource GhostBrush}"/>
            <DockPanel Margin="0,8,0,0">
                <Button x:Name="CancelOperationButton" DockPanel.Dock="Right" Style="{StaticResource CreditUseButton}"
                        Click="OnCancelOperation" Visibility="Collapsed" Margin="10,0,0,0"/>
                <TextBlock x:Name="OperationStatus" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
            </DockPanel>
        </StackPanel>
        <DockPanel Grid.Row="3" Margin="0,14,0,0">
            <Button x:Name="DoneButton" DockPanel.Dock="Right" Style="{StaticResource CreditUseButton}" Click="OnDone" Margin="12,0,0,0"/>
            <TextBlock x:Name="PrivacyHint" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
        </DockPanel>
    </Grid>
    </Border>
</Window>
