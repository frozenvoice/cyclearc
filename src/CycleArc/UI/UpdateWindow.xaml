<Window x:Class="CycleArc.UI.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="510" Height="540" MinWidth="420" MinHeight="430"
        WindowStartupLocation="CenterScreen" Style="{StaticResource AppWindow}">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock x:Name="Heading" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock x:Name="VersionLabel" Margin="0,10,0,0" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
        </StackPanel>
        <TextBlock x:Name="StatusLabel" Grid.Row="1" Margin="0,20,0,16" TextWrapping="Wrap" LineHeight="21"/>
        <Border Grid.Row="2" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="1" CornerRadius="10" Padding="16">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <TextBlock x:Name="NotesLabel" TextWrapping="Wrap" LineHeight="22"/>
            </ScrollViewer>
        </Border>
        <StackPanel Grid.Row="3" Margin="0,18,0,18">
            <ProgressBar x:Name="DownloadProgress" Height="5" Minimum="0" Maximum="100" Foreground="{DynamicResource AccentBrush}"
                         Background="{DynamicResource LineBrush}" Visibility="Collapsed"/>
            <TextBlock x:Name="PreservationLabel" Foreground="{DynamicResource MutedBrush}"
                       FontSize="12" TextWrapping="Wrap" LineHeight="19" Margin="0,10,0,0"/>
        </StackPanel>
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Button x:Name="CheckButton" Content="Check again" Style="{StaticResource GhostButton}" HorizontalAlignment="Left"
                    Click="OnCheck" FocusVisualStyle="{StaticResource ControlFocusVisual}"/>
            <Button x:Name="LaterButton" Grid.Column="1" Content="Later" Margin="8,0" Style="{StaticResource GhostButton}"
                    Click="OnLater" IsCancel="True" FocusVisualStyle="{StaticResource ControlFocusVisual}"/>
            <Button x:Name="ActionButton" Grid.Column="2" Content="Download update" Style="{StaticResource PrimaryButton}"
                    Click="OnAction" FocusVisualStyle="{StaticResource ControlFocusVisual}"/>
        </Grid>
    </Grid>
</Window>
